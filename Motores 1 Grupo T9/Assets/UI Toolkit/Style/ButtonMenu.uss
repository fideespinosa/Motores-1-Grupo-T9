.selected {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Font/Rajdhani-Bold.ttf?fileID=12800000&guid=585eb9b5ee4ddb84e987fe35c590e8e5&type=3#Rajdhani-Bold");
    font-size: 45px;
    background-color: rgba(0, 0, 0, 0.67);
    color: rgb(195, 195, 195);
    position: absolute;
    transition-duration: 0.25s;
}

.selected:focus {
    background-color: rgba(0, 0, 0, 0.57);
}

.selected:hover {
    background-color: rgba(183, 183, 183, 0.62);
    color: rgb(29, 28, 28);
}

.labelName {
    position: absolute;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Font/Rajdhani-Bold.ttf?fileID=12800000&guid=585eb9b5ee4ddb84e987fe35c590e8e5&type=3#Rajdhani-Bold");
    font-size: 88px;
    color: rgb(183, 183, 183);
    border-bottom-width: 2px;
    border-left-color: rgb(183, 183, 183);
    border-right-color: rgb(183, 183, 183);
    border-top-color: rgb(183, 183, 183);
    border-bottom-color: rgb(183, 183, 183);
}

.Pause {
    font-size: 42px;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Font/BebasNeue-Regular.ttf?fileID=12800000&guid=6c9b1dd03ba69b84a8389a9131329982&type=3#BebasNeue-Regular");
    width: 203px;
    transition-duration: 0.25s;
    background-color: rgb(144, 144, 144);
}

.Pause:focus {
    color: rgb(145, 145, 145);
    font-size: 42px;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Font/BebasNeue-Regular.ttf?fileID=12800000&guid=6c9b1dd03ba69b84a8389a9131329982&type=3#BebasNeue-Regular");
    background-color: rgb(27, 27, 27);
}

.Pause:hover {
    color: rgb(145, 145, 145);
    font-size: 42px;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Font/BebasNeue-Regular.ttf?fileID=12800000&guid=6c9b1dd03ba69b84a8389a9131329982&type=3#BebasNeue-Regular");
    background-color: rgb(27, 27, 27);
}
