.glitch-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    transition-property: opacity;
    transition-duration: 0.3s;
    -unity-material: url("project://database/Assets/UI Toolkit/M_CRTGlitch.mat");
    background-color: rgb(0, 0, 0);
}

.drone-crt-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-material: url("project://database/Assets/UI%20Toolkit/M_DroneGlitch.mat?fileID=2100000&guid=6b91db0be8fe81a4dbe9856535dcd5f5&type=2#M_DroneGlitch");
    background-color: rgb(0, 0, 0);
}
