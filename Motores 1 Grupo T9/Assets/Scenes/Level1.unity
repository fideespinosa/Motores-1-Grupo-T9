  m_Script: {fileID: 11500000, guid: dbede58aef5fa2f4d8c6ecb10d92caf0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SubtitleSequencePlayer
  displayedText: {fileID: 691475120}
  panel: {fileID: 235684793}
  panelCanvasGroup: {fileID: 235684795}
  subtitles:
  - text: '"<smallcaps>COMUNICADO INICIANDO: </smallcaps>"'
    displayDuration: 4
  - text: "\"Saludos ciudadano N\xB0 49H02, inquilino de la unidad J5113.\""
    displayDuration: 5.8
  - text: "\"Soy Cali, el agende de IA del sistema de recaudaci\xF3n civico zona
      departamental J5\""
    displayDuration: 5.4
  - text: "\"Mediante esta comunicaci\xF3n hago oficial su notificaci\xF3n sobre:
      \""
    displayDuration: 4.3
  - text: '"<mark>Deuda</mark> de habitabilidad para 3"'
    displayDuration: 1.7
  - text: '"<mark>Deuda</mark> de servicio clinico a distancia para uno por: "'
    displayDuration: 2.5
  - text: '"$<u>5.217.092</u> Unidades crediticias."'
    displayDuration: 4
  - text: "\"Por favor presentece ante la unidad J00 para saldar su <mark>deuda</mark>
      o solicitar el nuevo cr\xE9dito funcional postcrisis para ciudadanos <mark>valiosos
      como usted</mark>.\""
    displayDuration: 10.3
  - text: '"Saludos, y gracias por confiarnos el <s>futuro de su familia</s>"'
    displayDuration: 5
  fadeInDuration: 0.5
  fadeOutDuration: 0.5
