  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\"Es dificil interpretar cu\xE1nto tiempo transcurri\xF3 desde el <mark>accidente</mark>.
    En las <mark>profundidades</mark>, sin el sol, no puedo percibir el paso del
    tiempo, y los datos horarios y geogr\xE1ficos de la nave est\xE1n profundamente
    alterados.\n\n\nLas comunicaciones siguen intervenidas, y la IA de la nave no
    puede darme ninguna informaci\xF3n relevante.\n\n\nLo \xFAnico que <u>puedo hacer
    es seguir sus indicaciones</u> hasta poder establecer conectividad con el exterior.\n\n\nMe
    pregunto c\xF3mo estar\xE1n en <mark>casa</mark>, dar\xEDa lo que sea por verlos
    de nuevo.\n\n\n<mark>Hijo</mark>, si alg\xFAn dia ves esto, <mark>Pap\xE1 te
    ama y extra\xF1a cada segundo de su vida...</mark>\""
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: fba930da494e8d247b2b053c15b0928e, type: 2}
