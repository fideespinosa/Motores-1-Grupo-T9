  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dbede58aef5fa2f4d8c6ecb10d92caf0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SubtitleSequencePlayer
  displayedText: {fileID: 691475120}
  panel: {fileID: 235684793}
  panelCanvasGroup: {fileID: 235684795}
  subtitles:
  - text: '"Bienvenido de nuevo. Tripulante <u>49H02</u>."'
    displayDuration: 3.5
  - text: "\"Escaneo geol\xF3gico: completado.\""
    displayDuration: 1.8
  - text: "\"He localizado <mark>recursos cr\xEDticos</mark> en este sector... que
      permitir\xE1n continuar las reparaciones.\""
    displayDuration: 4
  - text: '"Despliega el Dron de reconocimiento en <mark>la pantalla derecha</mark>."'
    displayDuration: 2
  - text: "\"Ver\xE1s la funcionalidad en tu <mark>monitor derecho</mark>.\""
    displayDuration: 2
  - text: "\"Una vez en la superficie... podr\xE1s mover la unidad utilizando las
      teclas <mark>W, A ,S, D</mark> del teclado.\""
    displayDuration: 7.7
  - text: '"Recuerda la prioridad: asegurar el sector. Restaurar los sistemas de
      la nave. Y evaluar la viabilidad de la colonia."'
    displayDuration: 7.7
  - text: '"La Tierra... no tiene <s>margen de error</s>."'
    displayDuration: 2.3
  - text: '"Evita riesgos innecesarios. <u>Cuidado ahi afuera</u>."'
    displayDuration: 3.2
  fadeInDuration: 0.5
  fadeOutDuration: 0.5
