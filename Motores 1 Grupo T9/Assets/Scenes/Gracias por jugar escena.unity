  m_Script: {fileID: 11500000, guid: 4ff29b351ffd304488bd952dd46735ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SubtitleFinalScene
  displayedText: {fileID: 599707908}
  panel: {fileID: 2009157605}
  subtitles:
  - text: FUISTE CAPTURADO
    textColor: {r: 1, g: 1, b: 1, a: 1}
    sizeText: 80
    displayDuration: 0.7
    targetPosition: {fileID: 490057317}
    showSimultaneouslyWithNext: 0
  - text: 'PERO ESTE NO ES EL FINAL DE '
    textColor: {r: 1, g: 1, b: 1, a: 1}
    sizeText: 80
    displayDuration: 0.4
    targetPosition: {fileID: 1525243549}
    showSimultaneouslyWithNext: 1
  - text: TU VIAJE
    textColor: {r: 0.9528302, g: 0.112362035, b: 0.112362035, a: 1}
    sizeText: 80
    displayDuration: 0.7
    targetPosition: {fileID: 1525243549}
    showSimultaneouslyWithNext: 0
  - text: 'DESDE TERMINAL 9 GAMES

      QUEREMOS AGRADECERTE'
    textColor: {r: 1, g: 1, b: 1, a: 1}
    sizeText: 80
    displayDuration: 0.7
    targetPosition: {fileID: 1374730598}
    showSimultaneouslyWithNext: 1
  - text: POR JUGAR NUESTRA DEMO
    textColor: {r: 0.260624, g: 1, b: 0.1462264, a: 1}
    sizeText: 80
    displayDuration: 0.7
    targetPosition: {fileID: 1374730598}
    showSimultaneouslyWithNext: 0
  - text: 'SEGUIMOS EN NUESTRAS REDES PARA

      ENTERARTE CUANDO SALGA'
    textColor: {r: 1, g: 1, b: 1, a: 1}
    sizeText: 80
    displayDuration: 0.7
    targetPosition: {fileID: 2078980303}
    showSimultaneouslyWithNext: 1
  - text: LA VERSION COMPLETA
    textColor: {r: 0.260624, g: 1, b: 0.1462264, a: 1}
    sizeText: 80
    displayDuration: 0.7
    targetPosition: {fileID: 2078980303}
    showSimultaneouslyWithNext: 0
  - text: 'PROGRAMADORES, DESARROLLADORES DE LOGICA Y ARQUICTECTURA:'
    textColor: {r: 1, g: 1, b: 1, a: 1}
    sizeText: 60
    displayDuration: 0.7
    targetPosition: {fileID: 1558795057}
    showSimultaneouslyWithNext: 1
  - text: '- FIDEL ESPINOSA'
    textColor: {r: 1, g: 1, b: 1, a: 1}
    sizeText: 60
    displayDuration: 0.7
    targetPosition: {fileID: 1558795057}
    showSimultaneouslyWithNext: 1
  - text: '- BRIAN SANCHEZ'
    textColor: {r: 1, g: 1, b: 1, a: 1}
    sizeText: 60
    displayDuration: 0.7
    targetPosition: {fileID: 1558795057}
    showSimultaneouslyWithNext: 1
  - text: '- AGUSTIN SALVADO'
    textColor: {r: 1, g: 1, b: 1, a: 1}
    sizeText: 60
    displayDuration: 0.7
    targetPosition: {fileID: 1558795057}
    showSimultaneouslyWithNext: 0
  - text: 'ARTE 3D, MODELADO, ANIMACIONES Y TEXTURAS:'
    textColor: {r: 1, g: 1, b: 1, a: 1}
    sizeText: 60
    displayDuration: 0.7
    targetPosition: {fileID: 1558795057}
    showSimultaneouslyWithNext: 1
  - text: '- DENIS LIAM CRUZ'
    textColor: {r: 1, g: 1, b: 1, a: 1}
    sizeText: 60
    displayDuration: 0.7
    targetPosition: {fileID: 1558795057}
    showSimultaneouslyWithNext: 1
  - text: '- LEONEL GOTTE'
    textColor: {r: 1, g: 1, b: 1, a: 1}
    sizeText: 60
    displayDuration: 0.7
    targetPosition: {fileID: 1558795057}
    showSimultaneouslyWithNext: 0
  - text: "DISE\xD1O SONORO, COMPOSICION E IMPLEMENTACION:"
    textColor: {r: 1, g: 1, b: 1, a: 1}
    sizeText: 60
    displayDuration: 0.7
    targetPosition: {fileID: 1558795057}
    showSimultaneouslyWithNext: 1
  - text: "- AGUST\xCDN SASSONE"
    textColor: {r: 1, g: 1, b: 1, a: 1}
    sizeText: 60
    displayDuration: 0.7
    targetPosition: {fileID: 1558795057}
    showSimultaneouslyWithNext: 0
  - text: "DISE\xD1O UI / UX"
    textColor: {r: 1, g: 1, b: 1, a: 1}
    sizeText: 60
    displayDuration: 0.7
    targetPosition: {fileID: 1558795057}
    showSimultaneouslyWithNext: 1
  - text: '- DAMIAN GARNICA'
    textColor: {r: 1, g: 1, b: 1, a: 1}
    sizeText: 60
    displayDuration: 0.7
    targetPosition: {fileID: 1558795057}
    showSimultaneouslyWithNext: 0
  - text: CREDITOS
    textColor: {r: 1, g: 1, b: 1, a: 1}
    sizeText: 80
    displayDuration: 0.7
    targetPosition: {fileID: 2078980303}
    showSimultaneouslyWithNext: 1
  - text: 'QUEREMOS AGRADECER ESPECIALMENTE A '
    textColor: {r: 1, g: 1, b: 1, a: 1}
    sizeText: 70
    displayDuration: 0.7
    targetPosition: {fileID: 2078980303}
    showSimultaneouslyWithNext: 1
  - text: '- DIRECCION Y ADMINISTRACION DEL '
    textColor: {r: 1, g: 1, b: 1, a: 1}
    sizeText: 80
    displayDuration: 0.7
    targetPosition: {fileID: 2078980303}
    showSimultaneouslyWithNext: 1
  - text: CENTRO DE E-LEARNING UTN
    textColor: {r: 0.21786614, g: 0.4528302, b: 0.18155928, a: 1}
    sizeText: 70
    displayDuration: 0.7
    targetPosition: {fileID: 2078980303}
    showSimultaneouslyWithNext: 1
  - text: '- PROFESORA MARIA VICTORIA SASSOLA'
    textColor: {r: 1, g: 1, b: 1, a: 1}
    sizeText: 70
    displayDuration: 0.7
    targetPosition: {fileID: 2078980303}
    showSimultaneouslyWithNext: 0
  - text: GRACIAS POR JUGAR
    textColor: {r: 1, g: 1, b: 1, a: 1}
    sizeText: 80
    displayDuration: 0.7
    targetPosition: {fileID: 2078980303}
    showSimultaneouslyWithNext: 1
